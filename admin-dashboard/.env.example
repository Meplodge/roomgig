# Supabase project - used ONLY to sign the admin in and obtain a JWT.
# This is the public anon key, the same one the mobile app uses.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base URL of admin-api. All data flows through it.
VITE_ADMIN_API_URL=http://localhost:4000

# NEVER put SUPABASE_SERVICE_ROLE_KEY in this file. Vite inlines every VITE_*
# variable into the JavaScript bundle that ships to the browser.
