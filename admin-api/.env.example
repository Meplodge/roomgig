# Port the admin API listens on
PORT=4000

# Supabase project. Same URL as EXPO_PUBLIC_SUPABASE_URL in the app's root .env
SUPABASE_URL=https://your-project.supabase.co

# SERVICE ROLE key - bypasses RLS. NEVER expose this to a browser, never commit it,
# never copy it into a VITE_* variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ANON key - safe to use server-side. Only needed so /api/me/password can verify
# an admin's current password by signing in on an isolated, throwaway client
# (it must NOT use the service-role client for the sign-in, or the resulting
# session would hijack the shared client's PostgREST Authorization header and
# lock the dashboard out via RLS). Same value as VITE_SUPABASE_ANON_KEY in
# admin-dashboard/.env.
SUPABASE_ANON_KEY=your-anon-key

# Comma-separated list of allowed dashboard origins (no wildcards in production)
ADMIN_DASHBOARD_ORIGIN=http://localhost:5173

# Optional: health check target for the email notification service
EMAIL_API_URL=http://localhost:3000
