# Port the admin API listens on
PORT=4000

# Supabase project. Same URL as EXPO_PUBLIC_SUPABASE_URL in the app's root .env
SUPABASE_URL=https://your-project.supabase.co

# SERVICE ROLE key - bypasses RLS. NEVER expose this to a browser, never commit it,
# never copy it into a VITE_* variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of allowed dashboard origins (no wildcards in production)
ADMIN_DASHBOARD_ORIGIN=http://localhost:5173

# Optional: health check target for the email notification service
EMAIL_API_URL=http://localhost:3000
